<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'ShopSmart' %></title>
  <% if (!vuln) { %>
  <!-- SAFE mode: a Content-Security-Policy that blocks inline scripts helps
       neutralise injected <script>. (Set as a meta tag for the demo.) -->
  <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'" />
  <% } %>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <header class="topbar">
    <a class="brand" href="/">🛒 ShopSmart</a>
    <form class="searchbar" action="/search" method="get">
      <input type="text" name="q" placeholder="Search products…" value="" />
      <button type="submit">Search</button>
    </form>
    <nav>
      <a href="/">Products</a>
      <% if (user) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/profile">Profile</a>
        <a href="/logout">Logout (<%= user.username %>)</a>
      <% } else { %>
        <a href="/login">Login</a>
        <a href="/register">Register</a>
      <% } %>
    </nav>
  </header>
  <div class="mode-banner <%= vuln ? 'vuln' : 'safe' %>">
    Running in <strong><%= mode %></strong> mode
  </div>
  <main class="container">
